{
  "name": "graficos",
  "version": "3.0.0",
  "type": "module",
  "description": "human | engineer",
  "author": "paul_melero",
  "scripts": {
    "dev": "NODE_OPTIONS=--no-experimental-webstorage nuxt dev",
    "build": "NODE_OPTIONS=\"--max-old-space-size=6144 --no-experimental-webstorage\" nuxt build",
    "generate": "NODE_OPTIONS=\"--max-old-space-size=6144 --no-experimental-webstorage\" nuxt generate",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "precommit": "pnpm run lint:fix && pnpm run format",
    "prepare": "nuxt prepare",
    "preview": "pnpm build && pnpm dlx wrangler dev",
    "newsletter:install": "pnpm --dir newsletter install",
    "newsletter:sync": "pnpm --dir newsletter sync",
    "newsletter:dev": "pnpm --dir newsletter dev",
    "newsletter:build": "pnpm --dir newsletter build",
    "newsletter:preview": "pnpm --dir newsletter preview",
    "newsletter:send": "pnpm --dir newsletter send",
    "test": "vitest",
    "test:smoke": "vitest run --config vitest.smoke.config.ts"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0",
    "volta": ">=1.1.1"
  },
  "packageManager": "pnpm@9.12.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "better-sqlite3",
      "esbuild",
      "sharp",
      "workerd"
    ]
  },
  "dependencies": {
    "@nuxt/fonts": "^1.2.1",
    "@types/three": "^0.182.0",
    "@vueuse/core": "^15.0.0",
    "@vueuse/nuxt": "^15.0.0",
    "better-sqlite3": "^13.2.0",
    "feed": "^5.2.0",
    "nitro": "^3.0.261103-rc",
    "nuxt": "^4.7.0",
    "three": "^0.182.0",
    "vue": "^3.5.46"
  },
  "devDependencies": {
    "@iconify-json/material-symbols-light": "^1.2.53",
    "@iconify-json/octicon": "^1.2.20",
    "@iconify/vue": "^5.0.0",
    "@nuxt/content": "^3.17.0",
    "@nuxt/devtools": "^4.2.2",
    "@nuxt/image": "^2.2.1",
    "@nuxt/kit": "4.7.0",
    "@nuxt/rsbuild-builder": "4.7.0",
    "@nuxt/schema": "^4.7.0",
    "@nuxt/test-utils": "^4.4.0",
    "@nuxtjs/color-mode": "^4.1.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^25.0.9",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^20.14.5",
    "lightningcss": "^1.31.1",
    "nuxt-content-twoslash": "^0.4.0",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "shiki": "^4.4.3",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vitest": "^4.0.2",
    "wrangler": "^4.59.3",
    "zod": "^3.25.76"
  }
}
